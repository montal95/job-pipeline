# ── Anthropic ──────────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic (default). Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here

# ── Gemini (dev/test alternative — free tier) ──────────────────────────────────
# Get a free key at https://aistudio.google.com/
# Set LLM_PROVIDER=gemini to use Gemini instead of Anthropic for writer calls.
# Useful for testing the writer without spending Anthropic credits.
GEMINI_API_KEY=your-key-here
LLM_PROVIDER=anthropic

# ── CV path ────────────────────────────────────────────────────────────────────
# Absolute path to your CV PDF on the local filesystem.
# This file is never committed — it is loaded at runtime only.
# A synthetic plain-text fixture lives at tests/fixtures/sample_cv.txt for unit tests.
CV_PATH=/absolute/path/to/your/cv.pdf

# ── Database paths ─────────────────────────────────────────────────────────────
# Application DB: job search data (jobs, submissions, search runs, company cache)
APP_DB_PATH=./data/pipeline.db

# Checkpoint DB: LangGraph execution state (separate from app DB)
CHECKPOINT_DB_PATH=./data/checkpoints.db

# ── Output paths ───────────────────────────────────────────────────────────────
OUTPUT_DIR=./output

# ── Search defaults ────────────────────────────────────────────────────────────
DEFAULT_LOCATION=Chicago, IL
DEFAULT_REMOTE=true
DEFAULT_MAX_RESULTS_PER_SOURCE=25

# ── Discovery source toggles ───────────────────────────────────────────────────
# Comma-separated. LinkedIn and ZipRecruiter require Playwright auth sessions.
# Indeed and Dice use httpx (no auth required).
ENABLED_SOURCES=indeed,dice,linkedin,ziprecruiter

# ── Title filter ───────────────────────────────────────────────────────────────
# Applied in merge_results BEFORE fingerprint dedup and DB lookup.
# Matching is case-insensitive substring. Negative wins over positive.
# Empty TITLE_FILTER_POSITIVE = allow everything that isn't negated.
TITLE_FILTER_POSITIVE=
# Comma-separated titles/roles to always reject (seniority, role mismatches).
TITLE_FILTER_NEGATIVE=manager,director,principal,staff,vp,head of,intern,qa analyst

# ── Writer settings ─────────────────────────────────────────────────────────────
MAX_REVISION_ROUNDS=3

# ── Candidate identity — used by fill_form for ATS text fields ─────────────────
CANDIDATE_FIRST_NAME=Samuel
CANDIDATE_LAST_NAME=Montalvo
CANDIDATE_EMAIL=sammontalvojr@gmail.com
CANDIDATE_PHONE=214-686-7539
CANDIDATE_LINKEDIN_URL=https://linkedin.com/in/samuel-montalvo-jr/

# ── Ghost listing detection ─────────────────────────────────────────────────────
# Jobs not seen in a discovery run for this many days are flagged as possibly_inactive
GHOST_THRESHOLD_DAYS=14

# ── Dice API key ────────────────────────────────────────────────────────────────
# Public key from Dice's frontend bundle — not a secret, but may rotate.
# To refresh: open dice.com, run a job search, copy x-api-key from DevTools Network tab.
DICE_API_KEY=1YAt0R9wBg4WfsF9VB2778F5CHLAPMVH3IWmTf45
